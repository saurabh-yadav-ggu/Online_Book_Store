# Django Security & Core Settings
# In production on Vercel, set a strong random secret key
DJANGO_SECRET_KEY=your_production_django_secret_key_here
DEBUG=False
# ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.vercel.app

# Database Configuration (Supabase PostgreSQL Transaction Pooler or Neon)
DATABASE_URL=postgresql://username:password@your-pooler-host.supabase.com:6543/postgres?sslmode=require

# Cashfree Payment Gateway Configuration
# Obtain credentials from https://merchant.cashfree.com/ (Production) or Sandbox portal
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
